  {
    "id": "k8s",
    "group": "클라우드",
    "name": "Kubernetes (k3s)",
    "description": "admin 에 KUBERNETES 벤더로 등록: API 주소 https://certbear.k3s:6443, 토큰은 아래 버튼. 네임스페이스 certbear-test 에 sample-tls 시크릿과 sample-web 디플로이먼트가 있습니다.",
    "services": ["k8s"],
    "actions": [
      {
        "id": "token",
        "label": "SA 토큰 보기",
        "command": ["docker", "exec", "certbear.k3s", "kubectl", "-n", "certbear-test", "get", "secret", "certbear-admin-token", "-o", "jsonpath={.data.token}"],
        "decodeBase64": true
      },
      {
        "id": "resources",
        "label": "리소스 보기",
        "command": ["docker", "exec", "certbear.k3s", "kubectl", "-n", "certbear-test", "get", "secret,deploy,pod"]
      }
    ]
  },
  {
    "id": "aws",
    "group": "클라우드",
    "name": "AWS (moto)",
    "description": "admin 에 AWS 벤더로 등록: Access Key testing / Secret testing / 리전 ap-northeast-2 / 경유 서버(endpoint) https://certbear.aws:443. ACM 인증서 1개와 이를 쓰는 ALB HTTPS 리스너가 미리 만들어져 있습니다.",
    "services": ["aws"],
    "actions": [
      {
        "id": "seed",
        "label": "시드 결과 보기",
        "command": ["docker", "logs", "certbear.aws"],
        "grep": "[seed]"
      }
    ]
  }
