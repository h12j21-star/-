# 복사해서 사용: cp .env.example .env  (값을 바꾸지 않으면 아래 기본값으로 동작)

# 소스 경로 — 이 저장소 기준 상대 경로 또는 절대 경로.
# PC 의 폴더 이름이 다르면 바꾼다 (예: UI 폴더가 "ui" 면 UI_SRC=../../ui)
ADMIN_SRC=../../certbear-admin
UI_SRC=../../certbear-ui
AGENT_SRC=../../certbear-agent

# 포트
CONTROL_PORT=7000
UI_PORT=8443
ADMIN_MANAGER_PORT=6680
ADMIN_AGENT_PORT=6681
DB_PORT=15432
K8S_API_PORT=16443
AWS_PORT=14566
TARGET_NGINX_1_PORT=9441
TARGET_NGINX_2_PORT=9442
TARGET_APACHE_PORT=9443
TARGET_TOMCAT_PORT=9444

# admin (테스트 전용 값 — 운영 값을 넣지 말 것)
DB_PASSWORD=certbear-test
ADMIN_JWT_SECRET=certbear-testbed-jwt
ADMIN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
ADMIN_SUPER_ADMIN_EMAIL=
ADMIN_LOG_LEVEL=debug

# 에이전트가 붙을 admin 주소 (컨테이너 네트워크 안의 이름)
AGENT_ADMIN_ADDRESS=https://certbear.admin:6681
